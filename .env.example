# Copy to .env and fill in. .env is gitignored — never commit it.

# API-Football (https://www.api-football.com) — licensed provider.
API_FOOTBALL_KEY=
# Free plan: 100/day. The ETL stops before using the last N requests of the day.
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_RESERVE=5

# Where the DuckDB file and raw response cache live (gitignored).
WESCOUT_DATA_DIR=data

# Hide all local_scrape data from API responses and show attribution. Use true for any public demo.
PUBLIC_MODE=true

# Scraper providers (Transfermarkt, SofaScore) are for local personal use only and off by default.
ENABLE_LOCAL_SCRAPERS=false
